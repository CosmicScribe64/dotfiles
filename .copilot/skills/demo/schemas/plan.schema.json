{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:demonstration:plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "title", "workspace", "steps"],
  "properties": {
    "version": { "const": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "workspace": { "type": "string", "minLength": 1 },
    "secretEnv": { "type": "array", "uniqueItems": true, "maxItems": 100, "items": { "$ref": "#/$defs/env" } },
    "allowedOrigins": { "type": "array", "uniqueItems": true, "maxItems": 30, "items": { "type": "string", "format": "uri" } },
    "steps": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "$ref": "#/$defs/step" } }
  },
  "$defs": {
    "env": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$" },
    "strings": { "type": "array", "maxItems": 30, "items": { "type": "string", "maxLength": 2000 } },
    "pointer": { "type": "string", "pattern": "^(?:/(?:[^~/]|~[01])*)*$" },
    "jsonChecks": {
      "type": "array", "maxItems": 30,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["pointer", "equals"],
        "properties": { "pointer": { "$ref": "#/$defs/pointer" }, "equals": {} }
      }
    },
    "callout": {
      "type": "object", "required": ["type", "label"], "unevaluatedProperties": false,
      "properties": { "label": { "type": "string", "minLength": 1, "maxLength": 120 } },
      "oneOf": [
        {
          "required": ["x", "y", "width", "height"],
          "properties": {
            "type": { "const": "box" },
            "x": { "type": "number", "minimum": 0, "maximum": 1 },
            "y": { "type": "number", "minimum": 0, "maximum": 1 },
            "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
          }
        },
        {
          "required": ["start", "end"],
          "properties": {
            "type": { "const": "lines" },
            "start": { "type": "integer", "minimum": 1 },
            "end": { "type": "integer", "minimum": 1 }
          }
        },
        { "required": ["selector"], "properties": { "type": { "const": "selector" }, "selector": { "type": "string", "minLength": 1 } } },
        { "properties": { "type": { "const": "tag" } } }
      ]
    },
    "action": {
      "type": "object", "required": ["op"], "unevaluatedProperties": false,
      "oneOf": [
        {
          "required": ["selector"],
          "properties": { "op": { "enum": ["click", "check", "uncheck", "expectVisible"] }, "selector": { "type": "string", "minLength": 1 } }
        },
        {
          "required": ["selector"],
          "properties": {
            "op": { "const": "fill" }, "selector": { "type": "string", "minLength": 1 },
            "value": { "type": "string" }, "valueEnv": { "$ref": "#/$defs/env" }
          },
          "oneOf": [ { "required": ["value"], "not": { "required": ["valueEnv"] } }, { "required": ["valueEnv"], "not": { "required": ["value"] } } ]
        },
        {
          "required": ["selector", "value"],
          "properties": { "op": { "enum": ["press", "select"] }, "selector": { "type": "string", "minLength": 1 }, "value": { "type": "string" } }
        },
        {
          "required": ["selector", "text"],
          "properties": { "op": { "const": "expectText" }, "selector": { "type": "string", "minLength": 1 }, "text": { "type": "string" } }
        },
        { "required": ["label"], "properties": { "op": { "const": "snapshot" }, "label": { "type": "string", "minLength": 1, "maxLength": 160 } } },
        { "properties": { "op": { "const": "reload" } } }
      ]
    },
    "step": {
      "type": "object", "required": ["id", "title", "rationale", "kind"], "unevaluatedProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "edgeCases": { "$ref": "#/$defs/strings" },
        "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 120000 },
        "callouts": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/callout" } }
      },
      "oneOf": [
        {
          "required": ["argv"],
          "properties": {
            "kind": { "const": "command" },
            "argv": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "string", "minLength": 1 } },
            "expectExit": { "type": "integer", "minimum": 0, "maximum": 255 },
            "stdoutIncludes": { "$ref": "#/$defs/strings" },
            "stderrIncludes": { "$ref": "#/$defs/strings" },
            "format": { "enum": ["text", "json", "diff"] },
            "jsonEquals": { "$ref": "#/$defs/jsonChecks" },
            "select": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "$ref": "#/$defs/pointer" } },
            "maxBytes": { "type": "integer", "minimum": 256, "maximum": 2097152 }
          },
          "allOf": [
            { "if": { "anyOf": [ { "required": ["jsonEquals"] }, { "required": ["select"] } ] }, "then": { "required": ["format"], "properties": { "format": { "const": "json" } } } }
          ]
        },
        {
          "required": ["url"],
          "properties": {
            "kind": { "const": "api" }, "url": { "type": "string", "format": "uri" },
            "headersEnv": { "type": "object", "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9-]*$" }, "additionalProperties": { "$ref": "#/$defs/env" } },
            "expectStatus": { "type": "integer", "minimum": 100, "maximum": 599 },
            "jsonEquals": { "$ref": "#/$defs/jsonChecks" },
            "select": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "$ref": "#/$defs/pointer" } }
          }
        },
        {
          "required": ["file"],
          "properties": {
            "kind": { "const": "json" }, "file": { "type": "string", "minLength": 1 },
            "jsonEquals": { "$ref": "#/$defs/jsonChecks" },
            "select": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "$ref": "#/$defs/pointer" } }
          }
        },
        {
          "required": ["paths"],
          "properties": {
            "kind": { "const": "diff" }, "base": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/~^-]*$" },
            "paths": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "type": "string", "minLength": 1 } }
          }
        },
        {
          "required": ["file", "media"],
          "properties": {
            "kind": { "const": "artifact" }, "file": { "type": "string", "minLength": 1 },
            "media": { "enum": ["text", "json", "diff", "image", "video"] }, "sanitized": { "const": true }
          },
          "allOf": [ { "if": { "properties": { "media": { "enum": ["image", "video"] } } }, "then": { "required": ["sanitized"] } } ]
        },
        {
          "required": ["url", "actions"],
          "properties": {
            "kind": { "const": "ui" }, "url": { "type": "string", "format": "uri" },
            "viewport": {
              "type": "object", "additionalProperties": false, "required": ["width", "height"],
              "properties": { "width": { "type": "integer", "minimum": 320, "maximum": 1920 }, "height": { "type": "integer", "minimum": 400, "maximum": 1080 } }
            },
            "actions": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/action" } },
            "mask": { "$ref": "#/$defs/strings" }, "video": { "type": "boolean" }, "sanitized": { "const": true }
          },
          "allOf": [ { "if": { "required": ["video"], "properties": { "video": { "const": true } } }, "then": { "required": ["sanitized"] } } ]
        }
      ]
    }
  }
}
